{
  "expo": {
    "name": "BookRide",
    "slug": "BookRide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "https://images.pexels.com/photos/15372518/pexels-photo-15372518/free-photo-of-steering-wheel-in-renault-car.jpeg?auto=compress&cs=tinysrgb&w=600",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "https://images.pexels.com/photos/15372518/pexels-photo-15372518/free-photo-of-steering-wheel-in-renault-car.jpeg?auto=compress&cs=tinysrgb&w=600"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
